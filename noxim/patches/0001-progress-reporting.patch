+int getProgressIntervalCycles()
+{
+    const char *value = getenv("NOXIM_PROGRESS_INTERVAL_CYCLES");
+    if (value == NULL || value[0] == '\0')
+        return 0;
+
+    char *end = NULL;
+    long interval = strtol(value, &end, 10);
+    if (end == value || interval <= 0)
+        return 0;
+
+    return (int) interval;
+}
+
+void runSimulationWithProgress(int total_cycles)
+{
+    int progress_interval = getProgressIntervalCycles();
+    if (progress_interval <= 0 || progress_interval >= total_cycles) {
+        sc_start(sc_time((double)total_cycles * GlobalParams::clock_period_ps, SC_PS));
+        return;
+    }
+
+    using clock_type = chrono::steady_clock;
+    const clock_type::time_point start = clock_type::now();
+    int simulated = 0;
+
+    while (simulated < total_cycles) {
+        const int chunk = min(progress_interval, total_cycles - simulated);
+        sc_start(sc_time((double)chunk * GlobalParams::clock_period_ps, SC_PS));
+        simulated += chunk;
+
+        const double fraction = simulated / (double)total_cycles;
+        const chrono::duration<double> elapsed = clock_type::now() - start;
+        const double elapsed_seconds = elapsed.count();
+        const double eta_seconds =
+            fraction > 0.0 ? elapsed_seconds * (1.0 - fraction) / fraction : 0.0;
+
+        ostringstream progress;
+        progress << fixed << setprecision(1);
+        progress << "[progress] "
+                 << simulated << "/" << total_cycles << " cycles ("
+                 << (fraction * 100.0) << "%), "
+                 << "elapsed " << elapsed_seconds << "s, "
+                 << "eta " << eta_seconds << "s";
+        cout << progress.str() << endl;
+    }
+}
